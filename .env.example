# Database (PostgreSQL / Neon)
# In Production (Render with Neon):
# 1. DATABASE_URL: Neon POOLED connection string (host ends in '-pooler.us-east-2.aws.neon.tech')
#    Used by the running Next.js application for connection pooling.
# 2. DIRECT_URL: Neon DIRECT connection string (host does NOT have '-pooler')
#    Used by Prisma CLI for migrations / db push to bypass PgBouncer.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# For Local Development (uncomment if testing against local Postgres):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mocktest?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/mocktest?schema=public"

# NextAuth / Auth.js (In Production VPS: set AUTH_URL="https://mockshikhar.com")
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# App Config
NEXT_PUBLIC_APP_NAME="Mockshikhar"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Account (used by `npm run create-admin`)
ADMIN_EMAIL="admin@mockshikhar.com"
ADMIN_PASSWORD="YourStrongAdminPassword123"

# Email Verification Provider (Brevo Transactional API)
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
EMAIL_FROM="Mockshikhar <support@mockshikhar.com>"

# Minimum attempts before showing rank/percentile
MIN_ATTEMPTS_FOR_RANKING=30
