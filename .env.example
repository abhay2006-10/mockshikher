# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mocktest?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# App Config
NEXT_PUBLIC_APP_NAME="Mockshikhar"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Account (used by `npm run create-admin`)
ADMIN_EMAIL="admin@mockshikhar.com"
ADMIN_PASSWORD="YourStrongAdminPassword123"

# Email Verification Provider (Optional: Resend or Brevo)
RESEND_API_KEY=""
EMAIL_FROM="Mockshikhar <onboarding@yourdomain.com>"
# BREVO_API_KEY=""
# BREVO_SENDER_EMAIL=""

# Minimum attempts before showing rank/percentile
MIN_ATTEMPTS_FOR_RANKING=30
