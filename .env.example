# Database (PostgreSQL / Supabase)
# In Production / Staging (Supabase):
# 1. DATABASE_URL: Supabase Transaction POOLED connection string (port 6543, pooler.supabase.com)
#    Used by Next.js application runtime for high concurrency connection pooling (?pgbouncer=true).
# 2. DIRECT_URL: Supabase DIRECT connection string (port 5432, db.<project-ref>.supabase.co)
#    Used by Prisma CLI for db push / migrations to bypass PgBouncer.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# For Local Development (uncomment if testing against local Postgres):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mocktest?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/mocktest?schema=public"

# NextAuth / Auth.js (In Production VPS: set AUTH_URL="https://mockshikhar.com")
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# App Config
NEXT_PUBLIC_APP_NAME="Mockshikhar"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Account (used by `npm run create-admin`)
ADMIN_EMAIL="admin@mockshikhar.com"
ADMIN_PASSWORD="YourStrongAdminPassword123"

# Email Verification Provider (Brevo Transactional API)
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
EMAIL_FROM="Mockshikhar <support@mockshikhar.com>"

# Minimum attempts before showing rank/percentile
MIN_ATTEMPTS_FOR_RANKING=30
